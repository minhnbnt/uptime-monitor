# GoTrue configuration for uptime-monitor (dev).
# Private ES256 signing key lives in .env.gotrue-es256 (generated by tools/keygen).
# The issuer MUST be reachable by both clients and services; when running via
# docker compose it is http://gotrue:9999 for in-network services.

GOTRUE_JWT_VALID_METHODS=ES256
GOTRUE_JWT_SECRET=uptime-monitor-dev-secret-do-not-use-in-prod
GOTRUE_JWT_ISSUER=http://gotrue:9999
GOTRUE_JWT_AUD=uptime-monitor
GOTRUE_JWT_EXP=3600

GOTRUE_DB_DRIVER=postgres
DB_NAMESPACE=auth
DATABASE_URL=postgres://supabase_auth_admin:root@postgres:5432/gotrue?search_path=auth

API_EXTERNAL_URL=http://localhost:9999
GOTRUE_SITE_URL=http://localhost:3000
GOTRUE_API_HOST=0.0.0.0
PORT=9999

GOTRUE_MAILER_AUTOCONFIRM=true
