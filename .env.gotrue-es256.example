# Copy the private signing key into your local .env.gotrue-es256 (gitignored).
# Generate it with:
#
#   go run ./tools/keygen
#
# And mint a service_role JWT for notification-service with:
#
#   go run ./tools/keygen --service-token
GOTRUE_JWT_KEYS='[{"kty":"EC","crv":"P-256","x":"REPLACE","y":"REPLACE","d":"REPLACE","kid":"REPLACE","alg":"ES256","use":"sig","key_ops":["sign","verify"]}]'
GOTRUE_JWT_VALID_METHODS=ES256
